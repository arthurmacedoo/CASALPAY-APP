# ───────────────────────────────────────────────
# CasalPay — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas chaves do Firebase
# ───────────────────────────────────────────────

# Suas chaves do Firebase (encontradas em Project Settings > General > Your apps)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# ID secreto do casal — mude para algo único e difícil de adivinhar
# Ex: "arthur-e-ela-2026-secreto" ou qualquer texto aleatório
# IMPORTANTE: os dois celulares devem usar exatamente o mesmo valor
VITE_COUPLE_ID=arthur-namorada-2026
