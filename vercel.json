{
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://casalpay.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/init.json",
      "destination": "https://casalpay.firebaseapp.com/__/firebase/init.json"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-check-pending",
      "schedule": "0 3 * * *"
    }
  ]
}
